# Server-only Neon database connection
DATABASE_URL=

# Google OAuth web client settings
# GOOGLE_CLIENT_ID is intentionally exposed to the browser at build time.
GOOGLE_CLIENT_ID=

# A random 32+ byte secret used only to sign the app session cookie.
SESSION_SECRET=

# Comma-separated addresses. Run `npm run seed:admins` after setting this on a new database.
ADMIN_EMAILS=tonychiang061952@gmail.com
