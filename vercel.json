{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/Spillover%20Insurance",
      "destination": "https://baojiajia.tw/blog/spillover-insurance-benefits",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.baojiajia.tw"
        }
      ],
      "destination": "https://baojiajia.tw/$1",
      "permanent": true
    }
  ]
}
